# Models tried in order (lite first: fastest, no thinking step)

# Gemini (required)
GEMINI_API_KEY=AIzaSy...your_actual_key_here
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.8-flash

# Backup models tried when every Gemini model fails (usually overload). Same API key.
# BACKUP_MODELS=gemma-4-26b-a4b-it,gemma-4-31b-it

# Optional Google Cloud model fallback
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# GOOGLE_CLOUD_ACCESS_TOKEN=your_access_token_here
# GOOGLE_CLOUD_MODELS=gemma-3-1b-it,gemma-3-4b-it

PORT=8080

# Signs play tokens. Required when deployed: use the same long random value on every instance.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# PLAY_TOKEN_SECRET=

# Optional: "Forgot password?" emails a reset link through any SMTP account. With Gmail, turn on 2-Step Verification,
# create an App password (myaccount.google.com/apppasswords) and use smtp.gmail.com with that password.
# Running locally without these, reset links are printed in the server log instead of emailed.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# MAIL_FROM=QuestPulse <you@gmail.com>
# The address people open the site at, used for links in emails. Required when deployed.
# PUBLIC_URL=https://your-domain.example
